<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <assignments>
        <name>Hold_For_Review</name>
        <label>Hold For Review</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>$Record.Approval_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Hold_Reason__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>HoldReason</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Needs_Review</name>
        <label>Needs Review?</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Passes quality bar</defaultConnectorLabel>
        <rules>
            <name>Below_Quality_Bar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NeedsHold</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Hold_For_Review</targetReference>
            </connector>
            <label>Below quality bar</label>
        </rules>
    </decisions>
    <description>Holds auto-approved Reels for human review when the Creative Director score is below the threshold in InstaAgent Settings, or when post-render QA found issues.</description>
    <formulas>
        <name>HoldReason</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.QA_Issues__c})), &quot;QA issues: &quot; &amp; LEFT({!$Record.QA_Issues__c}, 200), &quot;Quality score &quot; &amp; TEXT({!$Record.Quality_Score__c}) &amp; &quot; is below the bar of &quot; &amp; TEXT({!$Setup.InstaAgent_Settings__c.Quality_Threshold__c}))</expression>
    </formulas>
    <formulas>
        <name>NeedsHold</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISPICKVAL({!$Record.Approval_Status__c}, &quot;Auto-Approved&quot;), OR(NOT(ISBLANK({!$Record.QA_Issues__c})), AND(NOT(ISBLANK({!$Record.Quality_Score__c})), {!$Record.Quality_Score__c} &lt; BLANKVALUE({!$Setup.InstaAgent_Settings__c.Quality_Threshold__c}, 8))))</expression>
    </formulas>
    <interviewLabel>Reel Quality Gate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Reel Quality Gate</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Needs_Review</targetReference>
        </connector>
        <object>Anime_Content__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
