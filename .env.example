# Copy to .env (gitignored) for local runs. In GitHub Actions these come from repo Secrets/Variables.
# Never commit real values. Never paste them into chats or issues.

# Access token (GitHub Secret IG_ACCESS_TOKEN).
#   Unified Login: Business Integration System User token, starts with "EAA".
#   Instagram Login: Instagram User token, starts with "IGAA".
IG_ACCESS_TOKEN=

# Which Meta setup issued the token: unified (default) or instagram.
IG_LOGIN=unified

# Instagram professional account ID (GitHub Variable IG_USER_ID).
# Optional: looked up automatically if the token can access exactly one account.
IG_USER_ID=

# Graph API version (current as of 2026-11).
IG_API_VERSION=v27.0
