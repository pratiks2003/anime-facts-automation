# Copy to .env (gitignored) for local runs. In GitHub Actions these come from repo Secrets.
# Never commit real values. Never paste them into chats or issues.

# Long-lived Instagram User access token (Instagram API with Instagram Login).
# Valid ~60 days; refreshed automatically by the token-refresh workflow.
IG_ACCESS_TOKEN=

# Optional: Instagram professional account ID. If empty it is looked up via /me.
IG_USER_ID=

# Optional: Graph API version (default v27.0, current as of 2026-11).
IG_API_VERSION=v27.0
